<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer boundary glow ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#2A3952" />
            <solid android:color="#141E2E" />
            <size android:width="220dp" android:height="220dp" />
        </shape>
    </item>
    <!-- Inner zone ring -->
    <item android:top="30dp" android:bottom="30dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#1F2C40" android:dashWidth="4dp" android:dashGap="4dp" />
            <solid android:color="#0F1724" />
        </shape>
    </item>
    <!-- Center deadzone crosshair ring -->
    <item android:top="85dp" android:bottom="85dp" android:left="85dp" android:right="85dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#384C6B" />
            <solid android:color="#0B101A" />
        </shape>
    </item>
</layer-list>
