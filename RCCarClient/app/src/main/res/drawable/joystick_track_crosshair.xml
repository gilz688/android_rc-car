<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer boundary glow ring -->
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/cockpit_border" />
            <solid android:color="@color/cockpit_surface_elevated" />
            <size android:width="220dp" android:height="220dp" />
        </shape>
    </item>
    <!-- Inner zone ring -->
    <item android:top="30dp" android:bottom="30dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/cockpit_border" android:dashWidth="4dp" android:dashGap="4dp" />
            <solid android:color="@color/cockpit_bg" />
        </shape>
    </item>
    <!-- Center deadzone crosshair ring -->
    <item android:top="85dp" android:bottom="85dp" android:left="85dp" android:right="85dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/cockpit_cyan" />
            <solid android:color="@color/cockpit_surface" />
        </shape>
    </item>
</layer-list>
