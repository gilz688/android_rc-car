<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer boundary panel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/cockpit_surface_elevated" />
            <stroke android:width="1dp" android:color="@color/cockpit_border" />
        </shape>
    </item>
    <!-- Vertical channel slot -->
    <item android:left="36dp" android:right="36dp" android:top="16dp" android:bottom="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/cockpit_bg" />
            <stroke android:width="2dp" android:color="@color/cockpit_border" />
        </shape>
    </item>
    <!-- Center reference guideline -->
    <item android:left="44dp" android:right="44dp" android:top="24dp" android:bottom="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/cockpit_amber" android:dashWidth="6dp" android:dashGap="6dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
