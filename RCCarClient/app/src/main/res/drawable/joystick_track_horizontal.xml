<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer boundary panel -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/cockpit_surface_elevated" />
            <stroke android:width="1dp" android:color="@color/cockpit_border" />
        </shape>
    </item>
    <!-- Horizontal channel slot -->
    <item android:top="36dp" android:bottom="36dp" android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/cockpit_bg" />
            <stroke android:width="2dp" android:color="@color/cockpit_border" />
        </shape>
    </item>
    <!-- Center reference guideline -->
    <item android:top="44dp" android:bottom="44dp" android:left="24dp" android:right="24dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/cockpit_cyan" android:dashWidth="6dp" android:dashGap="6dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
