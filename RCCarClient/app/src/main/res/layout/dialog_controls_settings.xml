<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cockpit_surface"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/cockpit_cyan"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/controls_settings_title"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cockpit_border"
        android:layout_marginBottom="16dp" />

    <!-- Hand Swap Switch -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_hand_swap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controls_hand_swap_title"
        android:textColor="@color/cockpit_text_primary"
        android:textSize="15sp"
        android:paddingVertical="8dp" />

    <TextView
        android:id="@+id/text_hand_swap_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Left: Throttle | Right: Steering"
        android:textColor="@color/cockpit_cyan"
        android:textSize="12sp"
        android:paddingStart="4dp"
        android:paddingBottom="12dp" />

    <!-- Control Mode Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controls_mode_title"
        android:textColor="@color/cockpit_text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/radio_group_control_mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_mode_joystick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_mode_joystick"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_mode_seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_mode_seekbar"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="14sp" />

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/radio_mode_accelerometer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/controls_mode_accelerometer"
            android:textColor="@color/cockpit_text_primary"
            android:textSize="14sp" />
    </RadioGroup>

    <!-- Invert Axes -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cockpit_border"
        android:layout_marginVertical="12dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_invert_throttle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controls_invert_throttle"
        android:textColor="@color/cockpit_text_primary"
        android:textSize="14sp"
        android:paddingVertical="6dp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switch_invert_steering"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/controls_invert_steering"
        android:textColor="@color/cockpit_text_primary"
        android:textSize="14sp"
        android:paddingVertical="6dp" />

    <!-- Dismiss Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Apply and Close"
        android:textAllCaps="true"
        android:backgroundTint="@color/cockpit_cyan"
        android:textColor="@color/black"
        app:cornerRadius="12dp" />
</LinearLayout>
