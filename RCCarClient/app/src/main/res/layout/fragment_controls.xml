<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/vertical_seek_bar_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="25dp"
        android:foregroundGravity="center"
        android:background="@drawable/joystick_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/button_horn"
        app:layout_constraintEnd_toStartOf="@+id/button_horn"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button_theme"
        app:layout_constraintTop_toBottomOf="@+id/button_theme">

        <com.jmedeisis.bugstick.Joystick
            app:force_square="true"
            android:id="@+id/horizontal_joystick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:foregroundGravity="center"
            app:motion_constraint="Horizontal">
            <Button
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/joystick_handle"/>
        </com.jmedeisis.bugstick.Joystick>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/horizontal_seek_bar_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:foregroundGravity="center"
        app:layout_constraintBottom_toTopOf="@+id/toggle_accelerometer"
        app:layout_constraintEnd_toStartOf="@+id/button_connect"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/toggle_accelerometer"
        app:layout_constraintTop_toBottomOf="@+id/button_connect">

        <com.jmedeisis.bugstick.Joystick
            android:id="@+id/vertical_joystick"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="25dp"
            android:background="@drawable/joystick_vertical"
            app:force_square="true"
            app:motion_constraint="Vertical">

            <Button
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:background="@drawable/joystick_handle" />
        </com.jmedeisis.bugstick.Joystick>
    </FrameLayout>


    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/button_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:contentDescription="App Theme"
        app:srcCompat="@drawable/ic_theme"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_alignParentRight="true"
        android:layout_marginLeft="10dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/button_connect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:contentDescription="Connect"
        app:srcCompat="@drawable/ic_connect"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_alignParentRight="true"
        android:layout_marginRight="10dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/button_horn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Horn"
        app:srcCompat="@drawable/ic_horn"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/toggle_accelerometer"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_alignParentRight="true" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/toggle_accelerometer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@+id/button_horn"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:contentDescription="Accelerometer"
        app:srcCompat="@drawable/ic_accelerometer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button_horn" />

</androidx.constraintlayout.widget.ConstraintLayout>
