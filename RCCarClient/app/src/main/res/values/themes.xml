<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: Modern Material 3 Cockpit -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryInverse">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/black</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:colorBackground">@color/cockpit_bg</item>
        <item name="colorSurface">@color/cockpit_surface</item>
        <item name="colorOnSurface">@color/cockpit_text_primary</item>
        <item name="colorSurfaceVariant">@color/cockpit_surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/cockpit_text_secondary</item>
        <item name="colorOutline">@color/cockpit_border</item>

        <item name="android:statusBarColor" tools:targetApi="l">@color/cockpit_bg</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">@color/cockpit_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="MyRounded.MaterialComponents.MaterialAlertDialog" parent="@style/ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.CustomDialog.Rounded</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.CustomDialog.Rounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
</resources>
